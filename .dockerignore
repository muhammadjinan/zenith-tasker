# Docker meta (not needed inside build)
docker-compose.yml
.dockerignore
sample.dockerignore
sample.gitignore

# Database data
postgres_data/

# User uploads
uploads/

# IDE / Editor
.idea/
.vscode/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Testing & docs
coverage/
__tests__/
README.md
LICENSE
docs/